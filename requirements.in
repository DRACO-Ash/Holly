# The set the App Store's python test job installs: it runs `pip install -r requirements.txt`, then
# `pytest --cov --cov-report=xml:coverage.xml`, so this lock carries the runtime set and the test
# runner, and nothing else. Exact pins only; never a range. The runtime set is held to the exact
# versions in the runtime lock, so the tests run against what the image ships.
#   uv pip compile requirements.in --universal --python-version 3.12 --generate-hashes -o requirements.txt
-c requirements-runtime.txt
-r requirements-runtime.in
pytest==9.1.1
pytest-cov==7.1.0
# Runs the async route and service tests (asyncio_mode = auto in pyproject.toml).
pytest-asyncio==1.4.0
