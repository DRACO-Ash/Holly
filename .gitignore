# Secrets and local environment: any environment file (.env, .env.*, .env-*, .envrc, *.env).
# Only the placeholder file is tracked.
.env*
*.env
!.env.example

# Local data
data/

# Python
.venv/
__pycache__/
*.py[cod]

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.complexipy_cache/

# Coverage and build output
coverage/
coverage.xml
.coverage
.coverage.*
htmlcov/
dist/

# The dashboard: dependencies, build output and coverage. The container build compiles
# frontend/ into src/app/static, so that directory is never committed either.
node_modules/
frontend/dist/
frontend/coverage/
src/app/static/
